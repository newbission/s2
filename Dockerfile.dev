# 개발 전용 이미지. 실서비스는 Vercel이 직접 빌드하므로 이 파일을 쓰지 않는다.
FROM node:24-bookworm-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_HOME=/opt/corepack \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# package.json의 packageManager에 적힌 pnpm 버전을 이미지에 미리 받아 둔다.
COPY package.json ./
RUN corepack enable && mkdir -p /opt/corepack node_modules .next \
 && chown -R node:node /opt/corepack /app

# 볼륨으로 덮일 폴더는 위에서 node 사용자 소유로 만들어 둔다 (새 볼륨이 이 소유권을 이어받음).
USER node

# pnpm(과 pnpm 12가 처음 실행 때 받는 실행 파일)을 이미지에 미리 받아 둔다 (뜰 때마다 다시 받지 않게).
RUN corepack install && pnpm --version
EXPOSE 3000
